{
  "manifest_version": 3,
  "name": "browser-tune",
  "version": "0.1.0",
  "description": "Performance/memory profiles, declarative domain blocking and safe tab discarding. Local-first, zero telemetry.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "tabs"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "predefined",
        "enabled": true,
        "path": "rulesets/predefined.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
